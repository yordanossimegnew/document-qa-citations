# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# PostgreSQL with the pgvector extension (documents, chunks, embeddings and chat sessions)
#   In psql:  CREATE DATABASE docqa;  CREATE DATABASE docqa_test;
#             \c docqa      CREATE EXTENSION vector;   (and the same in docqa_test)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/docqa
# Used only by pytest (tables are truncated between tests: never point this at real data)
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/docqa_test

# Optional overrides
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
VOYAGE_MODEL=voyage-3.5        # EMBEDDING_DIM must match the model's output size
EMBEDDING_DIM=1024
CHUNK_CHARS=2400
CHUNK_OVERLAP=300
TOP_K=8                        # chunks sent to Claude per question
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
